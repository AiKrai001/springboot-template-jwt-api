# Business node identity
NODE_NAME=node-a
APP_PORT=18080

# Shared database
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver
SPRING_DATASOURCE_URL=jdbc:postgresql://10.0.0.20:5432/springboot_template
SPRING_DATASOURCE_USERNAME=app_user
SPRING_DATASOURCE_PASSWORD=change-me
JIMMER_DIALECT=org.babyfish.jimmer.sql.dialect.PostgresDialect
JIMMER_DATABASE_VALIDATION_MODE=ERROR

# Shared Redis
SPRING_DATA_REDIS_HOST=10.0.0.21
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=

# Central Loki
LOKI_HOST=10.0.0.10
LOKI_PORT=3100
LOKI_JOB=springboot-template-jwt-api
LOKI_SERVICE=springboot-template-jwt-api
LOKI_ENVIRONMENT=prod
